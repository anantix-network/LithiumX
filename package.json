{
  "name": "lithiumx",
  "version": "2.0.0",
  "description": "LithiumX A powerful, simple, and effective stable Lavalink client developed in TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:bench": "vitest bench",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"docs:generate": "typedoc --out docs/ src/ && vitepress build docs"
  },
  "author": "Anantix Network [Scarlettx]",
  "keywords": [
    "lavalink",
    "lavalink-client"
  ],
  "license": "MIT",
  "homepage": "https://github.com/anantix-network/LithiumX",
  "repository": {
    "type": "git",
    "url": "https://github.com/anantix-network/LithiumX.git"
  },
  "dependencies": {
    "@discordjs/collection": "^2.1.1",
    "cheerio": "^1.0.0",
    "ioredis": "^5.6.0",
    "tiny-typed-emitter": "^2.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
		"@types/node": "^22.13.10",
		"@types/ws": "^8.18.0",
		"discord.js": "^14.18.0",
		"dotenv": "^16.4.7",
		"tsd-jsdoc": "^2.5.0",
    "typedoc": "^0.28.1",
    "typedoc-plugin-markdown": "^4.5.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.27.0",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.8",
    "vue": "^3.5.13"
  }
}
